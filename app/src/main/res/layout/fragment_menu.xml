<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/ocean_deep_blue_bg"
    tools:context=".ui.MenuFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XO Game"
        android:textColor="@color/ocean_text_light"
        android:textSize="48sp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/start_game_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Start game"
        app:backgroundTint="@color/ocean_bright_blue_accent"/>

    <Button
        android:id="@+id/scoreboard_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Scoreboard"
        app:backgroundTint="@color/ocean_bright_blue_accent"/>

    <Button
        android:id="@+id/how_to_play_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="How to play"
        app:backgroundTint="@color/ocean_bright_blue_accent"/>

    <Button
        android:id="@+id/exit_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="Exit app"
        app:backgroundTint="@color/ocean_bright_blue_accent"/>

</LinearLayout>
