<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/forest_dark_green_bg"
    tools:context=".ui.MenuFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XO"
        android:textColor="@color/forest_text_light"
        android:textSize="96sp"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/start_game_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:text="Start game"
        app:backgroundTint="@color/forest_light_green_accent"/>

    <Button
        android:id="@+id/scoreboard_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Scoreboard"
        app:backgroundTint="@color/forest_light_green_accent"/>

    <Button
        android:id="@+id/how_to_play_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="How to play"
        app:backgroundTint="@color/forest_light_green_accent"/>

    <Button
        android:id="@+id/exit_button"
        style="@style/Widget.AppCompat.Button"
        android:layout_width="250dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:text="Exit app"
        app:backgroundTint="@color/forest_light_green_accent"/>

</LinearLayout>
